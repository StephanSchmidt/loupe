<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="color-scheme" content="dark">
<title>{{ .Title }} — AI Impact Report</title>
<link rel="stylesheet" href="assets/reveal.css">
<style>
  :root {
    --bg: #0b0f17;
    --bg-elev: #11172a;
    --fg: #e5e7eb;
    --fg-muted: #9ca3af;
    --fg-dim: #6b7280;
    --accent: #f59e0b;
    --accent-2: #3b82f6;
    --border: #1f2937;
    --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }
  /* reveal.js adds class="reveal-viewport" to <body> at init time, so a
     bare `body { background: ... }` rule loses the specificity battle
     against reveal.css's `.reveal-viewport { background: white }`.
     Target the same class to win. */
  html { background: var(--bg); }
  body, .reveal-viewport { background: var(--bg); margin: 0; }
  .reveal {
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-sans);
    font-size: 32px;
    font-weight: 400;
  }
  .reveal .slides { text-align: left; }
  .reveal h1, .reveal h2, .reveal h3, .reveal h4 {
    font-family: var(--font-sans);
    color: var(--fg);
    text-transform: none;
    letter-spacing: -0.01em;
    font-weight: 700;
    margin: 0 0 0.4em;
    line-height: 1.15;
  }
  .reveal h1 { font-size: 2.6em; }
  .reveal h2 { font-size: 1.6em; }
  .reveal h3 { font-size: 1.1em; color: var(--fg-muted); font-weight: 500; }
  .reveal h4 { font-size: 0.9em; margin: 0.7em 0 0.25em; }
  .reveal p { margin: 0.4em 0; line-height: 1.4; }
  .reveal a { color: var(--accent-2); }
  .reveal code {
    background: var(--bg-elev);
    padding: 1px 6px;
    border-radius: 3px;
    color: var(--accent);
    font-size: 0.85em;
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
  }
  .reveal ul { line-height: 1.5; margin: 0.2em 0 0.4em; padding-left: 1.2em; }
  .reveal li + li { margin-top: 0.25em; }
  .reveal b, .reveal strong { font-weight: 600; }
  .reveal .controls { color: var(--fg-muted); }
  .reveal .progress {
    color: var(--accent);
    background: var(--border);
    height: 3px;
  }
  .reveal .slide-number {
    background: transparent;
    color: var(--fg-dim);
    font-size: 13px;
  }

  /* Generic helpers */
  .reveal .eyebrow {
    font-size: 0.65em;
    color: var(--fg-muted);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
    margin: 0;
  }
  .reveal .accent { color: var(--accent); }
  .reveal .muted { color: var(--fg-muted); }
  .reveal .footnote {
    font-size: 0.55em;
    color: var(--fg-dim);
    margin-top: 0.8em;
  }

  /* Title slide — centered hero */
  .reveal .title-slide {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    height: 100%;
    min-height: 600px;
  }
  .reveal .title-slide .eyebrow { margin-bottom: 1.2em; }
  .reveal .title-slide h1 { color: var(--accent); margin: 0; font-size: 3em; }
  .reveal .title-slide .date {
    font-size: 1em;
    color: var(--fg-muted);
    margin: 0.8em 0 0.4em;
  }
  .reveal .title-slide .footnote { margin-top: 1em; font-size: 0.5em; }

  /* Big-number grid (adoption slide) */
  .reveal .big-number-grid {
    display: flex;
    justify-content: stretch;
    gap: 18px;
    margin: 0.8em 0 0;
  }
  .reveal .big-number-grid > div {
    flex: 1;
    text-align: center;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.9em 0.7em;
  }
  .reveal .big-number {
    font-size: 2.4em;
    font-weight: 700;
    line-height: 1;
    margin: 0 0 0.2em;
    color: var(--fg);
    letter-spacing: -0.02em;
  }
  .reveal .big-number.accent { color: var(--accent); }
  .reveal .big-number-grid p:not(.big-number) {
    color: var(--fg-muted);
    font-size: 0.5em;
    line-height: 1.35;
    margin: 0;
  }

  /* Charts. Fixed pixel dimensions in reveal's logical-slide coords
     (default 960x700) — reveal scales the slide via transform, so
     percentages / vh would fight that scale and ECharts would mis-measure. */
  .reveal .chart {
    width: 880px;
    height: 440px;
    margin: 14px auto 0;
  }

  /* Stats slide — compact distribution table */
  .reveal .stats-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.6em;
    margin: 0.3em 0 0.5em;
  }
  .reveal .stats-table th,
  .reveal .stats-table td {
    padding: 0.35em 0.6em;
    text-align: right;
    border-bottom: 1px solid var(--border);
  }
  .reveal .stats-table th {
    color: var(--fg-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85em;
  }
  .reveal .stats-table th:first-child,
  .reveal .stats-table td:first-child {
    text-align: left;
    color: var(--fg-muted);
  }
  .reveal .stats-table td.accent { color: var(--accent); font-weight: 600; }
  .reveal .stats-trend {
    font-size: 0.65em;
    margin: 0.3em 0 0.8em;
    color: var(--fg-muted);
  }
  .reveal .stats-trend .accent { color: var(--accent); font-weight: 600; }
  .reveal .stats-cohort-grid {
    display: flex;
    gap: 14px;
    margin-top: 0.4em;
  }
  .reveal .stats-cohort-grid > div {
    flex: 1;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.5em 0.7em;
    font-size: 0.6em;
  }
  .reveal .stats-cohort-grid h4 {
    margin: 0 0 0.2em;
    color: var(--accent);
    font-size: 0.95em;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
  }
  .reveal .stats-cohort-grid p { margin: 0.15em 0; }
  .reveal .stats-tools {
    margin-top: 0.6em;
  }
  .reveal .stats-tools h4 {
    margin: 0 0 0.15em;
    color: var(--accent);
    font-size: 0.6em;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
  }
  .reveal .stats-tools-table {
    width: auto;
    min-width: 360px;
    font-size: 0.55em;
  }
  .reveal .stats-tools-table th:first-child,
  .reveal .stats-tools-table td:first-child {
    color: var(--fg);
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
  }

  /* Methodology / caveats — denser body type */
  .reveal .caveats {
    font-size: 0.7em;
    line-height: 1.55;
    color: var(--fg);
  }
  .reveal .caveats h4 {
    color: var(--accent);
    font-size: 0.85em;
    margin: 0.4em 0 0.2em;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }
  .reveal .caveats ul { margin: 0.2em 0 0.6em; }
  .reveal .caveats p { margin: 0.4em 0; }

  /* AI Impact Scorecard — three axis cards with direction + confidence */
  .reveal .scorecard-grid {
    display: flex;
    gap: 16px;
    margin: 0.6em 0 0.4em;
  }
  .reveal .scorecard-grid > div {
    flex: 1;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.7em 0.8em;
    text-align: left;
  }
  .reveal .score-axis {
    font-size: 0.5em;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-muted);
    margin: 0 0 0.15em;
    font-weight: 600;
  }
  .reveal .score-headline {
    font-size: 1.5em;
    font-weight: 700;
    line-height: 1.1;
    margin: 0 0 0.12em;
    display: flex;
    align-items: baseline;
    gap: 0.25em;
  }
  .reveal .score-arrow { font-size: 0.9em; }
  .reveal .score-prepost { font-size: 0.5em; color: var(--fg-muted); margin: 0.1em 0; }
  .reveal .score-sub { font-size: 0.42em; color: var(--fg-dim); margin: 0.1em 0 0; }
  .reveal .score-badge {
    display: inline-block;
    font-size: 0.42em;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.2em 0.6em;
    border-radius: 999px;
    margin-top: 0.25em;
    border: 1px solid var(--border);
  }
  /* good / bad / flat state coloring — reuses the chart palette */
  .reveal .state-good { color: #22c55e; }
  .reveal .state-bad  { color: #ef4444; }
  .reveal .state-flat { color: var(--fg-dim); }
  .reveal .state-good.score-badge { background: rgba(34,197,94,0.12); border-color: rgba(34,197,94,0.4); }
  .reveal .state-bad.score-badge  { background: rgba(239,68,68,0.12); border-color: rgba(239,68,68,0.4); }
  .reveal .state-flat.score-badge { background: rgba(107,114,128,0.12); }
  .reveal .scorecard-summary { font-size: 0.7em; color: var(--fg); margin: 0.2em 0 0; }

  /* Inline significance chip appended to before/after headlines (#3) */
  .reveal .verdict {
    font-size: 0.85em;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 0.1em 0.5em;
    border-radius: 999px;
    border: 1px solid var(--border);
    white-space: nowrap;
  }
  .reveal .verdict.good  { color: #22c55e; background: rgba(34,197,94,0.10); }
  .reveal .verdict.bad   { color: #ef4444; background: rgba(239,68,68,0.10); }
  .reveal .verdict.noise { color: var(--fg-dim); background: rgba(107,114,128,0.10); }

  /* Brand logo — fixed to the viewport so it rides above every slide.
     Sits outside .reveal so it isn't affected by reveal's slide-scale transform. */
  .deck-logo {
    position: fixed;
    top: 18px;
    right: 22px;
    height: 44px;
    width: auto;
    opacity: 0.85;
    z-index: 1000;
    pointer-events: none;
    user-select: none;
  }
</style>
</head>
<body>
<img class="deck-logo" src="assets/loupe.svg" alt="Loupe">
<div class="reveal">
<div class="slides">

<section>
  <div class="title-slide">
    <p class="eyebrow">AI Impact Report</p>
    <h1>{{ .Title }}</h1>
    <p class="date">Week of {{ .ReportDate.Format "January 2, 2006" }}</p>
    <p class="footnote">Window: {{ .WindowStart.Format "Jan 02, 2006" }} – {{ .WindowEnd.Format "Jan 02, 2006" }}</p>
  </div>
  <aside class="notes">
    Loupe baseline report. Local-only — no data left this machine. Skeptic mode: the methodology slide lists what we measured and how.
  </aside>
</section>

<section>
  <h2>Adoption</h2>
  <div class="big-number-grid">
    <div>
      <p class="big-number">{{ .TotalCommits }}</p>
      <p>commits over {{ len .Weeks }} weeks</p>
    </div>
    <div>
      <p class="big-number accent">{{ printf "%.1f%%" .AICommitPct }}</p>
      <p>of commits carry an AI co-author trailer</p>
    </div>
    <div>
      <p class="big-number">{{ .AIAuthorCount }}/{{ .DistinctAuthorCount }}</p>
      <p>devs with at least one AI-tagged commit</p>
    </div>
  </div>
  <p class="footnote">{{ .CutoverText }}</p>
  <aside class="notes">
    Trailer-based detection is conservative: Claude and Aider write Co-Authored-By trailers by default; Cursor and Copilot generally don't. Real adoption among Cursor/Copilot users is likely higher.
  </aside>
</section>

{{ if .ScorecardAvailable }}
<section data-chart="scorecard">
  <p class="eyebrow">AI Impact Scorecard</p>
  <h2>Before AI → after, with confidence</h2>
  <div class="scorecard-grid">
    {{ range .Scorecard }}
    <div>
      <p class="score-axis">{{ .Name }} · {{ .Headline }}</p>
      <p class="score-headline"><span class="state-{{ .State }}">{{ .ChangeText }}</span> <span class="score-arrow state-{{ .State }}">{{ .Arrow }}</span></p>
      <p class="score-prepost">{{ .BeforeText }} → {{ .AfterText }}</p>
      {{ if .Sub }}<p class="score-sub">{{ .Sub }}</p>{{ end }}
      <span class="score-badge state-{{ .State }}">{{ .Verdict }}</span>
    </div>
    {{ end }}
  </div>
  <p class="scorecard-summary">{{ .ScorecardSummary }}</p>
  <p class="footnote">Direction is the metric's raw move; color marks better (green) / worse (red) / no real change (gray). Confidence is a bootstrap test on the weekly values either side of the cutover — "within noise" means this 6-month window can't tell the change apart from zero.</p>
  <aside class="notes">
    The honest one-liner the deck builds toward. Each axis: the before→after move, whether it's an improvement, and whether the window has enough signal to trust it. "Within noise" is not a failure — it's the correct verdict when the post-cutover cohort is too short to distinguish from random variation.
  </aside>
</section>
{{ end }}

<section data-chart="throughput">
  <h2>Weekly throughput</h2>
  <div id="throughput-chart" class="chart"></div>
  <aside class="notes">
    Commits per week, stacked human vs AI-tagged. Merge commits included. A truncated rightmost bar usually reflects a partial week.
  </aside>
</section>
{{ range .Charts.Focus }}{{ if .ThroughputJSON }}
<section data-chart="throughput--{{ .Slug }}">
  <h2>Weekly throughput — {{ .Name }}</h2>
  <div class="chart"></div>
</section>
{{ end }}{{ end }}

<section data-chart="productivity">
  <h2>Output per active developer</h2>
  <div id="productivity-chart" class="chart"></div>
  <p class="footnote">
    {{ if .ProductivityHasCutover }}<span class="accent">{{ printf "%.1f" .ProductivityBefore }}</span> commits/dev·week before AI → <span class="accent">{{ printf "%.1f" .ProductivityAfter }}</span> after.{{ if .ProductivityVerdict.Show }} <span class="verdict {{ .ProductivityVerdict.Class }}">{{ .ProductivityVerdict.Label }}</span>{{ end }}{{ end }}
  </p>
  <aside class="notes">
    Weekly commits ÷ active developers that week, split human vs AI-tagged. Normalising by headcount separates "more output" from "more people" (hiring/attrition). Commit count is a coarse proxy — read the trend, not the absolute.
  </aside>
</section>
{{ range .Charts.Focus }}{{ if .ProductivityJSON }}
<section data-chart="productivity--{{ .Slug }}">
  <h2>Output per active developer — {{ .Name }}</h2>
  <div class="chart"></div>
</section>
{{ end }}{{ end }}

<section data-chart="adoption">
  <h2>Adoption over time</h2>
  <div id="adoption-chart" class="chart"></div>
  <aside class="notes">
    Share of each week's commits that are human vs AI-tagged. The growing AI band matters more than any single week.
  </aside>
</section>
{{ range .Charts.Focus }}{{ if .AdoptionJSON }}
<section data-chart="adoption--{{ .Slug }}">
  <h2>Adoption over time — {{ .Name }}</h2>
  <div class="chart"></div>
</section>
{{ end }}{{ end }}

{{ if .Charts.HasRepoAdoption }}
<section data-chart="repoadoption">
  <h2>AI-enabled repos</h2>
  <div id="repoadoption-chart" class="chart"></div>
  <p class="footnote">
    <span class="accent">{{ .RepoAdoptionAdopted }} of {{ .RepoAdoptionTotal }}</span> repos have at least one AI commit. First adoption is a floor — once a repo shows AI it stays counted, regardless of later activity.
  </p>
  <aside class="notes">
    Per ISO week: repos with ≥1 AI commit (cumulative), with the remaining repos split by whether they committed in the last 90 days.
  </aside>
</section>
{{ range .Charts.Focus }}{{ if .HasRepoAdoption }}
<section data-chart="repoadoption--{{ .Slug }}">
  <h2>AI-enabled repos — {{ .Name }}</h2>
  <div class="chart"></div>
</section>
{{ end }}{{ end }}
{{ end }}

{{ if .StatsAvailable }}
<section>
  <h2>Distribution</h2>
  <table class="stats-table">
    <thead>
      <tr>
        <th>Per ISO week</th>
        <th>median</th>
        <th>p10</th>
        <th>p90</th>
        <th>min</th>
        <th>max</th>
        <th>mean</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Commits</td>
        <td>{{ printf "%.1f" .StatsCommits.Median }}</td>
        <td>{{ printf "%.1f" .StatsCommits.P10 }}</td>
        <td>{{ printf "%.1f" .StatsCommits.P90 }}</td>
        <td>{{ printf "%.0f" .StatsCommits.Min }}</td>
        <td>{{ printf "%.0f" .StatsCommits.Max }}</td>
        <td>{{ printf "%.1f" .StatsCommits.Mean }}</td>
      </tr>
      <tr>
        <td>AI commits</td>
        <td>{{ printf "%.1f" .StatsAICommits.Median }}</td>
        <td>{{ printf "%.1f" .StatsAICommits.P10 }}</td>
        <td>{{ printf "%.1f" .StatsAICommits.P90 }}</td>
        <td>{{ printf "%.0f" .StatsAICommits.Min }}</td>
        <td>{{ printf "%.0f" .StatsAICommits.Max }}</td>
        <td>{{ printf "%.1f" .StatsAICommits.Mean }}</td>
      </tr>
      <tr>
        <td>AI ratio</td>
        <td class="accent">{{ printf "%.1f%%" .StatsRatioPct.Median }}</td>
        <td>{{ printf "%.1f%%" .StatsRatioPct.P10 }}</td>
        <td>{{ printf "%.1f%%" .StatsRatioPct.P90 }}</td>
        <td>{{ printf "%.1f%%" .StatsRatioPct.Min }}</td>
        <td>{{ printf "%.1f%%" .StatsRatioPct.Max }}</td>
        <td>{{ printf "%.1f%%" .StatsRatioPct.Mean }}</td>
      </tr>
    </tbody>
  </table>
  {{ if .StatsTrendKnown }}
  <p class="stats-trend">Trend (AI ratio): <span class="accent">{{ printf "%+.1f pp/week" .StatsTrendSlope }}</span> ({{ .StatsTrendDirection }})</p>
  {{ end }}
  {{ if .StatsCutoverAvailable }}
  <div class="stats-cohort-grid">
    <div>
      <h4>Before cutover</h4>
      <p>{{ .StatsBeforeWeeks }} weeks</p>
      <p>commits mean <span class="accent">{{ printf "%.1f" .StatsBeforeCommits }}</span></p>
      <p>AI ratio mean <span class="accent">{{ printf "%.1f%%" .StatsBeforeRatioPct }}</span></p>
    </div>
    <div>
      <h4>After cutover</h4>
      <p>{{ .StatsAfterWeeks }} weeks</p>
      <p>commits mean <span class="accent">{{ printf "%.1f" .StatsAfterCommits }}</span></p>
      <p>AI ratio mean <span class="accent">{{ printf "%.1f%%" .StatsAfterRatioPct }}</span></p>
    </div>
  </div>
  {{ end }}
  {{ if .ToolsAvailable }}
  <div class="stats-tools">
    <h4>AI tools detected ({{ .ToolsCommitsTotal }} commit{{ if ne .ToolsCommitsTotal 1 }}s{{ end }})</h4>
    <table class="stats-table stats-tools-table">
      <thead>
        <tr>
          <th>Tool</th>
          <th>Commits</th>
          <th>Share</th>
        </tr>
      </thead>
      <tbody>
        {{ range .Tools }}
        <tr>
          <td>{{ .Source }}</td>
          <td>{{ .Commits }}</td>
          <td class="accent">{{ printf "%.1f%%" .Pct }}</td>
        </tr>
        {{ end }}
      </tbody>
    </table>
  </div>
  {{ end }}
  <aside class="notes">
    Distribution of weekly commit and AI-commit counts. p10 / p90 bracket the typical range, so a wide spread between them is more interesting than the mean. The cutover split compares the cohort means before vs. after the auto-detected adoption week. AI tools detected: per-tool share of attributed commits (a commit with signals from multiple tools counts under each).
  </aside>
</section>
{{ end }}

{{ if .CyclesAvailable }}
<section data-chart="cycle">
  <h2>Lead time</h2>
  <div id="cycle-chart" class="chart"></div>
  <p class="footnote">
    {{ .CycleTickets }} tickets with lead-time data — median Wait (Create → dev start) <span class="accent">{{ .MedianIdeaToDevText }}</span>, median Cycle (dev start → last commit) <span class="accent">{{ .MedianDevToRelText }}</span>.
    {{ printf "%.0f%%" .CycleFallbackPct }} of tickets used first-commit fallback (no matching tracker transition).
  </p>
  {{ if .LeadTimeHasCutover }}<p class="footnote">Median lead time <span class="accent">{{ printf "%.1f d" .LeadTimeBefore }}</span> before AI → <span class="accent">{{ printf "%.1f d" .LeadTimeAfter }}</span> after.{{ if .LeadTimeVerdict.Show }} <span class="verdict {{ .LeadTimeVerdict.Class }}">{{ .LeadTimeVerdict.Label }}</span>{{ end }}</p>{{ end }}
  <aside class="notes">
    Wait is ticket created → first tracker transition into a "dev started" status (or first commit, when no matching transition exists). Cycle is that moment → last commit on the ticket. Bars show the weekly median, so a few long-tail tickets don't distort the typical lead time.
  </aside>
</section>
{{ range .Charts.Focus }}{{ if .HasCycle }}
<section data-chart="cycle--{{ .Slug }}">
  <h2>Lead time — {{ .Name }}</h2>
  <div class="chart"></div>
</section>
{{ end }}{{ end }}
{{ end }}

{{ if .Charts.HasBugFix }}
<section data-chart="bugfix">
  <h2>Bug-fix speed</h2>
  <div id="bugfix-chart" class="chart"></div>
  <p class="footnote">
    {{ if .BugFixHasCutover }}Bug-fix engineering time <span class="accent">{{ printf "%.1f d" .BugLeadBefore }}</span> before AI → <span class="accent">{{ printf "%.1f d" .BugLeadAfter }}</span> after.{{ if .BugFixVerdict.Show }} <span class="verdict {{ .BugFixVerdict.Class }}">{{ .BugFixVerdict.Label }}</span>{{ end }}{{ else }}Median bug-fix engineering time <span class="accent">{{ printf "%.1f d" .OtherLeadOverall }}</span> baseline (non-bug work).{{ end }}
  </p>
  <aside class="notes">
    Median engineering time (dev start → last commit on the ticket) for defect-class tickets vs everything else, per ISO week. This isolates the part AI can plausibly speed — writing the fix — from triage wait (shown separately on the Lead-time slide). A falling Bug bar after the cutover is the "does AI fix bugs faster?" signal; compare it to the Other bar to rule out an org-wide speed-up. Medians, so a few long tails don't distort it.
  </aside>
</section>
{{ range .Charts.Focus }}{{ if .BugFixJSON }}
<section data-chart="bugfix--{{ .Slug }}">
  <h2>Bug-fix speed — {{ .Name }}</h2>
  <div class="chart"></div>
</section>
{{ end }}{{ end }}
{{ end }}

{{ if .Charts.HasPRCycle }}
<section data-chart="prcycle">
  <h2>PR cycle velocity</h2>
  <div id="prcycle-chart" class="chart"></div>
  <p class="footnote">
    {{ if .PRCycleHasCutover }}Median time to merge <span class="accent">{{ printf "%.1f d" .PRDaysBefore }}</span> before AI → <span class="accent">{{ printf "%.1f d" .PRDaysAfter }}</span> after.{{ if .PRCycleVerdict.Show }} <span class="verdict {{ .PRCycleVerdict.Class }}">{{ .PRCycleVerdict.Label }}</span>{{ end }} {{ end }}{{ printf "%.1f" .PRMergedPerWeek }} PRs merged/week on average.
  </p>
  <aside class="notes">
    Median time from a pull request opening to merge, per ISO week (bucketed by merge week; bot-authored PRs excluded). The most direct "did AI speed delivery?" signal that isn't confounded by ticket hygiene. Review/approval latency isn't ingested, so this is open→merge end-to-end, not time-in-review.
  </aside>
</section>
{{ range .Charts.Focus }}{{ if .PRCycleJSON }}
<section data-chart="prcycle--{{ .Slug }}">
  <h2>PR cycle velocity — {{ .Name }}</h2>
  <div class="chart"></div>
</section>
{{ end }}{{ end }}
{{ end }}

{{ if .Charts.HasRetention }}
<section data-chart="retention">
  <h2>AI-adoption retention</h2>
  <div id="retention-chart" class="chart"></div>
  <p class="footnote">
    <strong>How sticky is AI?</strong> Of <span class="accent">{{ .RetentionAdopters }}</span> developers who ever used AI, <span class="accent">{{ printf "%.0f%%" .RetentionRate }}</span> were still using it {{ .RetentionWeeks }} weeks later — the curve falling steeply then flattening means an initial trial drop-off, then a durable core.
  </p>
  <aside class="notes">
    A survival curve. Every developer is lined up at their own "week 0" — the week of their first AI-tagged commit — regardless of calendar date. The line at week k is the share of adopters whose AI use lasted at least k weeks (i.e. their most recent AI commit is k+ weeks after their first). Developers who started too recently to have reached week k are excluded from it, so recent adopters don't drag the curve down. Reads left-to-right: a cliff = honeymoon (people try it once and stop); a high flat line = durable adoption.
  </aside>
</section>
{{ end }}

{{ if .Charts.HasLandingTeam }}
<section data-chart="landingteam">
  <h2>Where AI lands — by team</h2>
  <div id="landingteam-chart" class="chart"></div>
  <p class="footnote">AI-tagged share of commits over the last {{ .DisplayMonths }} months ({{ .WindowStart.Format "Jan 2" }} – {{ .WindowEnd.Format "Jan 2, 2006" }}).</p>
  <aside class="notes">
    AI-tagged share of commits per configured team over the window. Characterises where AI adoption concentrates — what leaders act on. Teams come from config; developers in no team are not shown.
  </aside>
</section>
{{ end }}
{{ if .Charts.HasLandingRepo }}
<section data-chart="landingrepo">
  <h2>Where AI lands — by repo</h2>
  <div id="landingrepo-chart" class="chart"></div>
  <p class="footnote">AI-tagged share of commits over the last {{ .DisplayMonths }} months ({{ .WindowStart.Format "Jan 2" }} – {{ .WindowEnd.Format "Jan 2, 2006" }}); repos under 20 commits excluded.</p>
  <aside class="notes">
    AI-tagged share of commits, for the repos with the highest AI adoption (repos under 20 commits are excluded as too small to characterise). This surfaces where AI concentrates — note that high-volume repos can still sit near 0%, so a few AI-heavy services here is the signal, not the whole picture.
  </aside>
</section>
{{ end }}

{{ if .Charts.HasWIP }}
<section data-chart="wip">
  <h2>Work in progress</h2>
  <div id="wip-chart" class="chart"></div>
  <aside class="notes">
    Snapshot at the end of each ISO week of open tickets (created, not yet Done/Closed/Resolved), split by whether they've entered a "dev started" status. Rising "Not Started" signals a growing backlog.
  </aside>
</section>
{{ range .Charts.Focus }}{{ if .HasWIP }}
<section data-chart="wip--{{ .Slug }}">
  <h2>Work in progress — {{ .Name }}</h2>
  <div class="chart"></div>
</section>
{{ end }}{{ end }}
{{ end }}

{{ if .Charts.HasDefects }}
<section data-chart="defects">
  <h2>Quality counterweight</h2>
  <div id="defects-chart" class="chart"></div>
  <p class="footnote">
    <strong>Revert rate</strong> = commits whose message starts “Revert ” ÷ all commits.{{ if .DefectsHasBugs }} <strong>Bug rate</strong> = Jira <code>Bug</code> tickets ÷ all tickets created that week.{{ end }}
  </p>
  <p class="footnote">
    {{ if .DefectsHasCutover }}Revert rate <span class="accent">{{ printf "%.1f%%" .RevertRateBefore }}</span> before AI → <span class="accent">{{ printf "%.1f%%" .RevertRateAfter }}</span> after.{{ if .RevertVerdict.Show }} <span class="verdict {{ .RevertVerdict.Class }}">{{ .RevertVerdict.Label }}</span>{{ end }}{{ if .DefectsHasBugs }} Bug rate {{ printf "%.1f%%" .BugRateBefore }} → {{ printf "%.1f%%" .BugRateAfter }}.{{ if .BugRateVerdict.Show }} <span class="verdict {{ .BugRateVerdict.Class }}">{{ .BugRateVerdict.Label }}</span>{{ end }}{{ end }}{{ else }}Revert rate <span class="accent">{{ printf "%.1f%%" .RevertRateOverall }}</span>{{ if .DefectsHasBugs }}, bug rate {{ printf "%.1f%%" .BugRateOverall }}{{ end }} over the window.{{ end }}
  </p>
  <aside class="notes">
    Revert rate = commits whose message starts "Revert " — a floor, since roll-forward fixes and squash-hidden reverts are missed. Bug rate = Jira tickets of type Bug as a share of tickets created that week; it lags the work that caused it. Read this as a directional counterweight to the throughput gains, not a precise defect count.
  </aside>
</section>
{{ range .Charts.Focus }}{{ if .HasDefects }}
<section data-chart="defects--{{ .Slug }}">
  <h2>Quality counterweight — {{ .Name }}</h2>
  <div class="chart"></div>
</section>
{{ end }}{{ end }}
{{ end }}

<section>
  <h2>Methodology</h2>
  <div class="caveats">
    <h4>High-confidence (direct evidence)</h4>
    <ul>
      <li><code>Co-Authored-By</code> trailer (Claude, Aider, Copilot, Cursor, Devin, Gemini Code Assist, Jules, OpenCode)</li>
      <li>Body footer (<code>Generated with [Claude Code]</code>, <code>Generated with [opencode]</code>)</li>
      <li>Author identity is a known AI bot (Copilot Coding Agent, Devin, Gemini Code Assist, Jules)</li>
      <li>PR carries an AI label or originates from an AI branch prefix (<code>copilot/</code>, <code>cursor/</code>, …)</li>
      <li>Squash-merge recovery — trailers on pre-squash PR commits attributed to the merge SHA</li>
    </ul>
    <h4>Medium-confidence (inferred)</h4>
    <ul>
      <li>Seat-holder propagation — untagged commits from a developer who has direct AI evidence in the same week and repo</li>
      <li>Unrecognised <code>*[bot]</code> author identity — likely automated, tool unknown</li>
    </ul>
    <p><b>Cutover:</b> {{ .CutoverText }}</p>
  </div>
  <aside class="notes">
    Confidence levels feed the chart. The throughput stack splits into "AI (evidence)" and "AI (inferred)" whenever any week has medium-confidence commits.
  </aside>
</section>

<section>
  <h2>Caveats</h2>
  <div class="caveats">
    <h4>Not in this report yet</h4>
    <ul>
      {{ if not .Charts.HasCycle }}<li>Lead time (needs Jira tickets with status transitions)</li>{{ end }}
      {{ if not .Charts.HasWIP }}<li>Work in progress (needs Jira tickets)</li>{{ end }}
      {{ if not .Charts.HasDefects }}<li>Defect rate / quality counterweight</li>{{ end }}
      {{ if not .Charts.HasBugFix }}<li>Bug-fix speed (needs enough bug-typed tickets with linked commits)</li>{{ end }}
      {{ if not .Charts.HasPRCycle }}<li>PR cycle velocity (needs a re-ingest to capture PR merge timestamps)</li>{{ end }}
      {{ if not .Charts.HasLandingTeam }}<li>Per-team AI breakdown (needs <code>teams</code> in config)</li>{{ end }}
    </ul>
    <p>Cutover threshold: a week qualifies when AI-tagged commits reach <span class="accent">{{ printf "%.0f%%" .CutoverThresholdPct }}</span> of weekly commits.</p>
    <p class="muted">ROI is intentionally omitted — the assumption it requires (hours saved per AI-tagged commit) can't be defended in front of a skeptical CFO.</p>
  </div>
  <aside class="notes">
    The honest-measurement pitch. Skeptic-friendly slide.
  </aside>
</section>

</div>
</div>
<script src="assets/reveal.js"></script>
<script src="assets/echarts.min.js"></script>
<script>
  // ECharts option payloads built by internal/deck/charts.go and embedded
  // verbatim via template.JS — JSON object literals are valid JS.
  const throughputOption = {{ .Charts.ThroughputJSON }};
  const adoptionOption = {{ .Charts.AdoptionJSON }};
  {{ if .Charts.HasRepoAdoption }}const repoAdoptionOption = {{ .Charts.RepoAdoptionJSON }};{{ end }}
  {{ if .Charts.HasWIP }}const wipOption = {{ .Charts.WIPJSON }};{{ end }}
  {{ if .Charts.HasDefects }}const defectsOption = {{ .Charts.DefectsJSON }};{{ end }}
  {{ if .Charts.HasBugFix }}const bugfixOption = {{ .Charts.BugFixJSON }};{{ end }}
  {{ if .Charts.HasPRCycle }}const prcycleOption = {{ .Charts.PRCycleJSON }};{{ end }}
  {{ if .Charts.HasRetention }}const retentionOption = {{ .Charts.RetentionJSON }};{{ end }}
  {{ if .Charts.HasLandingTeam }}const landingTeamOption = {{ .Charts.LandingTeamJSON }};{{ end }}
  {{ if .Charts.HasLandingRepo }}const landingRepoOption = {{ .Charts.LandingRepoJSON }};{{ end }}
  {{ if .Charts.HasCycle }}const cycleOption = {{ .Charts.CycleJSON }};{{ end }}

  // Cutover indices come alongside the option payloads. The cutover
  // marker is drawn as a `graphic` overlay (see overlayCutover below)
  // because ECharts markLine on a category axis snaps to integer
  // indices, which forces the line through a bar centre.
  const chartOptions = {
    throughput: throughputOption,
    adoption: adoptionOption,
    productivity: {{ .Charts.ProductivityJSON }},
    {{ if .Charts.HasRepoAdoption }}repoadoption: repoAdoptionOption,{{ end }}
    {{ if .Charts.HasWIP }}wip: wipOption,{{ end }}
    {{ if .Charts.HasDefects }}defects: defectsOption,{{ end }}
    {{ if .Charts.HasBugFix }}bugfix: bugfixOption,{{ end }}
    {{ if .Charts.HasPRCycle }}prcycle: prcycleOption,{{ end }}
    {{ if .Charts.HasRetention }}retention: retentionOption,{{ end }}
    {{ if .Charts.HasLandingTeam }}landingteam: landingTeamOption,{{ end }}
    {{ if .Charts.HasLandingRepo }}landingrepo: landingRepoOption,{{ end }}
    {{ if .Charts.HasCycle }}cycle: cycleOption,{{ end }}
    {{ range .Charts.Focus }}
    {{ if .ThroughputJSON }}"throughput--{{ .Slug }}": {{ .ThroughputJSON }},{{ end }}
    {{ if .AdoptionJSON }}"adoption--{{ .Slug }}": {{ .AdoptionJSON }},{{ end }}
    {{ if .ProductivityJSON }}"productivity--{{ .Slug }}": {{ .ProductivityJSON }},{{ end }}
    {{ if .HasRepoAdoption }}"repoadoption--{{ .Slug }}": {{ .RepoAdoptionJSON }},{{ end }}
    {{ if .HasWIP }}"wip--{{ .Slug }}": {{ .WIPJSON }},{{ end }}
    {{ if .HasDefects }}"defects--{{ .Slug }}": {{ .DefectsJSON }},{{ end }}
    {{ if .BugFixJSON }}"bugfix--{{ .Slug }}": {{ .BugFixJSON }},{{ end }}
    {{ if .PRCycleJSON }}"prcycle--{{ .Slug }}": {{ .PRCycleJSON }},{{ end }}
    {{ if .HasCycle }}"cycle--{{ .Slug }}": {{ .CycleJSON }},{{ end }}
    {{ end }}
  };
  const cutoverIdx = {
    throughput: {{ .Charts.ThroughputCutoverIdx }},
    adoption: {{ .Charts.AdoptionCutoverIdx }},
    productivity: {{ .Charts.ProductivityCutoverIdx }},
    {{ if .Charts.HasRepoAdoption }}repoadoption: {{ .Charts.RepoAdoptionCutoverIdx }},{{ end }}
    {{ if .Charts.HasWIP }}wip: {{ .Charts.WIPCutoverIdx }},{{ end }}
    {{ if .Charts.HasDefects }}defects: {{ .Charts.DefectsCutoverIdx }},{{ end }}
    {{ if .Charts.HasBugFix }}bugfix: {{ .Charts.BugFixCutoverIdx }},{{ end }}
    {{ if .Charts.HasPRCycle }}prcycle: {{ .Charts.PRCycleCutoverIdx }},{{ end }}
    {{ if .Charts.HasCycle }}cycle: {{ .Charts.CycleCutoverIdx }},{{ end }}
    {{ range .Charts.Focus }}
    {{ if .ThroughputJSON }}"throughput--{{ .Slug }}": {{ .ThroughputCutoverIdx }},{{ end }}
    {{ if .AdoptionJSON }}"adoption--{{ .Slug }}": {{ .AdoptionCutoverIdx }},{{ end }}
    {{ if .ProductivityJSON }}"productivity--{{ .Slug }}": {{ .ProductivityCutoverIdx }},{{ end }}
    {{ if .HasRepoAdoption }}"repoadoption--{{ .Slug }}": {{ .RepoAdoptionCutoverIdx }},{{ end }}
    {{ if .HasWIP }}"wip--{{ .Slug }}": {{ .WIPCutoverIdx }},{{ end }}
    {{ if .HasDefects }}"defects--{{ .Slug }}": {{ .DefectsCutoverIdx }},{{ end }}
    {{ if .BugFixJSON }}"bugfix--{{ .Slug }}": {{ .BugFixCutoverIdx }},{{ end }}
    {{ if .PRCycleJSON }}"prcycle--{{ .Slug }}": {{ .PRCycleCutoverIdx }},{{ end }}
    {{ if .HasCycle }}"cycle--{{ .Slug }}": {{ .CycleCutoverIdx }},{{ end }}
    {{ end }}
  };
  const chartInstances = {};

  // overlayCutover draws a red dashed vertical line at the LEFT
  // boundary of the cutover bar's slot — bar `idx` is the first
  // AI-adoption week (per analyze.DetectCutover) and belongs on the
  // "post-AI" side of the line. Positions are computed in pixels via
  // convertToPixel so the line lands at the slot boundary regardless
  // of week count or reveal's slide scale.
  //   idx >= 1 → midpoint between bars (idx-1) and idx
  //   idx == 0 → left edge of bar 0's slot, sampled via bar 1
  function overlayCutover(instance, idx) {
    if (idx == null || idx < 0) {
      instance.setOption({ graphic: { elements: [{ $action: 'remove', id: 'cutover' }] } });
      return;
    }
    const pxC = instance.convertToPixel({ xAxisIndex: 0 }, idx);
    const pxNeighbour = instance.convertToPixel({ xAxisIndex: 0 }, idx === 0 ? 1 : idx - 1);
    if (!isFinite(pxC) || !isFinite(pxNeighbour)) return;
    const slotHalf = Math.abs(pxC - pxNeighbour) / 2;
    const x = pxC - slotHalf;

    // Plot vertical bounds: from the y-axis maximum (top) to minimum (bottom).
    const yExtent = instance.getModel().getComponent('yAxis', 0).axis.scale.getExtent();
    const yTop = instance.convertToPixel({ yAxisIndex: 0 }, yExtent[1]);
    const yBot = instance.convertToPixel({ yAxisIndex: 0 }, yExtent[0]);

    // When the line sits at the plot's left edge (idx == 0), a centred
    // pill would clip past the chart; nudge it to the right of the
    // line so it points INTO the plot instead of straddling the edge.
    const atLeftEdge = idx === 0;
    const pillX = atLeftEdge ? x + 4 : x - 60;
    const textX = atLeftEdge ? x + 64 : x;

    instance.setOption({
      graphic: {
        elements: [{
          id: 'cutover',
          type: 'group',
          silent: true,
          // zlevel lifts the marker into its own canvas layer so it draws
          // ON TOP of the series — full-height stacked bars otherwise cover
          // both the line and the label.
          zlevel: 1,
          z: 100,
          children: [
            {
              type: 'line',
              shape: { x1: x, y1: yTop, x2: x, y2: yBot },
              style: { stroke: '#ef4444', lineWidth: 3, lineDash: [8, 6] }
            },
            {
              type: 'rect',
              shape: { x: pillX, y: yTop - 32, width: 120, height: 22 },
              style: { fill: '#ef4444' }
            },
            {
              type: 'text',
              style: {
                text: '▼ AI cutover',
                fill: '#ffffff',
                fontWeight: 'bold',
                fontSize: 13,
                x: textX,
                y: yTop - 21,
                textAlign: 'center',
                textVerticalAlign: 'middle'
              }
            }
          ]
        }]
      }
    });
  }

  // Reveal hides non-current slides with display:none. Initialising an
  // ECharts instance on a hidden container locks it to 0×0 and resize()
  // doesn't always recover; instead lazy-init each chart the first time
  // its slide becomes visible. <section data-chart="..."> is the
  // discriminator so the script doesn't hard-code chart IDs.
  function showChartFor(slide) {
    if (!slide) return;
    const kind = slide.dataset && slide.dataset.chart;
    if (!kind || !chartOptions[kind]) return;
    const div = slide.querySelector('.chart');
    if (!div) return;
    let instance = chartInstances[kind];
    if (!instance) {
      instance = echarts.init(div, null, { renderer: 'canvas' });
      instance.setOption(chartOptions[kind]);
      chartInstances[kind] = instance;
    }
    instance.resize();
    overlayCutover(instance, cutoverIdx[kind]);
  }

  Reveal.initialize({
    hash: true,
    controls: true,
    progress: true,
    slideNumber: 'c/t',
    transition: 'fade',
    backgroundTransition: 'none'
  }).then(function () {
    Reveal.on('slidechanged', function (e) { showChartFor(e.currentSlide); });
    // Handle the case where the deck loads directly on a chart slide
    // (e.g. via #/3) — the slidechanged event won't fire for the initial slide.
    showChartFor(Reveal.getCurrentSlide());
    window.addEventListener('resize', function () {
      for (const k in chartInstances) {
        chartInstances[k].resize();
        overlayCutover(chartInstances[k], cutoverIdx[k]);
      }
    });
  });
</script>
</body>
</html>
